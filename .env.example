# SSH Connection Configuration
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=admin

# Authentication (use either password or key)
SSH_PASSWORD=your_password_here
# SSH_KEY=/root/.ssh/id_rsa

# Sudo/Su Passwords (optional)
SUDO_PASSWORD=your_sudo_password
SU_PASSWORD=your_su_password

# Timeout and Limits (optional)
TIMEOUT=60000
MAX_CHARS=1000

# Docker MCP Gateway Settings (optional)
# DISABLE_SUDO=true
